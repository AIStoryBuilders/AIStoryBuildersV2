@* Chat tab (UI-Behavior-Spec §16; V1 ChatControl.razor). *@
@using AIStoryBuildersV2.Shared.Knowledge
@using AIStoryBuildersV2.Shared.StoryChat
@implements IDisposable
@inject IStoryChatService Chat
@inject AIStoryBuildersService Svc
@inject BrowserInterop Js
@inject LogService Log

<div class="asb-chat">
    <div class="asb-chat-head">
        <span class="mi" aria-hidden="true">forum</span>
        <b>Story Chat Assistant</b>
        <ModelPicker @bind-Value="model" Disabled="streaming" Style="width:220px" Id="chat-model" />
        <span class="row asb-chat-kb" title="@(kbEmpty ? "This story's knowledge base is empty" : null)">
            <RadzenCheckBox TValue="bool" Value="searchKb" ValueChanged="OnSearchKbChanged" Name="chat-kb" Disabled="@(kbEmpty || streaming)" />
            <RadzenLabel Text="Search knowledgebase" Component="chat-kb" />
        </span>
        <span class="asb-sp"></span>
        <button class="asb-icon-btn-plain" title="Clear conversation" aria-label="Clear conversation"
                disabled="@(streaming || Bubbles.Count == 0)" @onclick="Clear">
            <span class="mi" aria-hidden="true">restart_alt</span>
        </button>
    </div>
    @if (loadingGraph)
    {
        <div class="asb-chat-loading" role="status">Loading the story graph…</div>
    }
    <div class="asb-chat-body" id="asb-chat-body">
        @if (Bubbles.Count == 0)
        {
            <div class="asb-chat-empty">
                <p>No messages yet. Ask a question about your story!</p>
                <small>Examples: "Are there any orphaned characters?", "Tell me about the main characters"</small>
            </div>
        }
        @foreach (var b in Bubbles)
        {
            if (b.IsUser)
            {
                <div class="asb-bubble asb-b-user"><small>You</small><span class="asb-user-text">@b.Text</span></div>
            }
            else if (b.RetryText is not null)
            {
                <div class="asb-bubble asb-b-ai asb-b-error" role="alert">
                    <small>AI</small>@b.Text
                    <div class="asb-mt">
                        <RadzenButton Text="Retry" Icon="refresh" ButtonStyle="ButtonStyle.Light" Size="ButtonSize.Small"
                                      Disabled="streaming" Click="@(() => RetryAsync(b))" />
                    </div>
                </div>
            }
            else
            {
                <div class="asb-bubble asb-b-ai">
                    <small>AI</small>
                    @if (b.Thinking)
                    {
                        <em>Thinking...</em>
                    }
                    else
                    {
                        <ChatMessageRenderer Content="@b.Text" Links="@Links" Resolve="@Resolve" />
                    }
                </div>
            }
        }
    </div>
    <div class="asb-chat-input">
        <textarea id="asb-chat-composer" rows="2" placeholder="Ask about your story..." @bind="input" @bind:event="oninput"
                  disabled="@streaming" aria-label="Message"></textarea>
        <RadzenButton Text="Send" ButtonStyle="ButtonStyle.Primary" Disabled="@(!CanSend)" Click="SendAsync" Style="align-self:stretch" />
    </div>
</div>

@code {
    [Parameter, EditorRequired] public Story Story { get; set; } = default!;

    /// <summary>Owned by StoryWorkspace so the conversation survives tab switches.</summary>
    [Parameter, EditorRequired] public List<ChatBubble> Bubbles { get; set; } = default!;

    /// <summary>The story's KB links for [[path]] citations (T15); null renders citations as text.</summary>
    [Parameter] public KbLinkBuilder? Links { get; set; }
    [Parameter] public Func<string, string?>? Resolve { get; set; }

    /// <summary>D16: whether the story's KB is empty and the remembered/default checkbox value (T16).</summary>
    [Parameter] public Func<Task<(bool Empty, bool Checked)>>? KnowledgeBaseDefault { get; set; }
    [Parameter] public EventCallback<bool> KnowledgeBaseChoiceChanged { get; set; }

    string? model;
    string input = "";
    bool streaming;
    bool loadingGraph = true;
    bool kbEmpty = true;
    bool searchKb;
    readonly CancellationTokenSource cts = new();
    DotNetObjectReference<StoryChatTab>? selfRef;
    int scrolledTo;

    bool CanSend => !streaming && !loadingGraph && !string.IsNullOrWhiteSpace(input);

    protected override async Task OnInitializedAsync()
    {
        if (KnowledgeBaseDefault is not null) (kbEmpty, searchKb) = await KnowledgeBaseDefault();
        try
        {
            await Svc.EnsureGraphExistsAsync(Story.Title);
        }
        catch (Exception ex)
        {
            Log.WriteToLog($"Story Chat: could not load the story graph: {ex.Message}");
        }
        loadingGraph = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            selfRef = DotNetObjectReference.Create(this);
            await Js.BindComposerAsync("asb-chat-composer", selfRef);
        }
        var signature = Bubbles.Count == 0 ? 0 : Bubbles.Count * 31 + Bubbles[^1].Text.Length;
        if (signature != scrolledTo && Bubbles.Count > 0)
        {
            scrolledTo = signature;
            await Js.ScrollIntoViewAsync("#asb-chat-body > :last-child", "end");
        }
    }

    [JSInvokable]
    public async Task OnComposerEnter(string value)
    {
        input = value;
        if (CanSend) await SendAsync();
    }

    [JSInvokable]
    public void OnComposerEscape() { }

    async Task OnSearchKbChanged(bool value)
    {
        searchKb = value;
        await KnowledgeBaseChoiceChanged.InvokeAsync(value);
    }

    async Task SendAsync()
    {
        if (!CanSend) return;
        var text = input.Trim();
        Bubbles.Add(new ChatBubble { IsUser = true, Text = text });
        input = "";
        await Js.ClearValueAsync("asb-chat-composer");
        await StreamAsync(text);
    }

    async Task RetryAsync(ChatBubble error)
    {
        if (streaming || error.RetryText is null) return;
        Bubbles.Remove(error);
        await StreamAsync(error.RetryText);
    }

    async Task StreamAsync(string text)
    {
        var ai = new ChatBubble { Thinking = true };
        Bubbles.Add(ai);
        streaming = true;
        StateHasChanged();
        try
        {
            var request = new StoryChatRequest(Story.Title, text, model ?? "", searchKb && !kbEmpty);
            await foreach (var chunk in Chat.SendMessageAsync(request, cts.Token))
            {
                ai.Text += chunk;
                ai.Thinking = false;
                StateHasChanged();
            }
            ai.Thinking = false;
        }
        catch (OperationCanceledException) when (cts.IsCancellationRequested)
        {
            return;
        }
        catch (Exception ex)
        {
            Bubbles.Remove(ai);
            Bubbles.Add(new ChatBubble { Text = "Error: " + ex.Message, RetryText = text });
            Log.WriteToLog($"Story Chat error: {ex.Message}");
        }
        finally
        {
            streaming = false;
        }
        StateHasChanged();
    }

    void Clear()
    {
        Bubbles.Clear();
        Chat.ClearSession(Story.Title);
    }

    public void Dispose()
    {
        cts.Cancel();
        cts.Dispose();
        selfRef?.Dispose();
    }
}
