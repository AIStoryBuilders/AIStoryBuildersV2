@page "/utility"
@* Utility (UI-Behavior-Spec §8; V1 UtilityClass.razor): fine-tuned models, training data and the JsonL utility (F18, D23). *@
@using System.Text
@using AIStoryBuildersV2.Shared.AI
@using AIStoryBuildersV2.Shared.Components.Utility
@using AIStoryBuildersV2.Shared.Llm
@using AIStoryBuildersV2.Shared.Settings
@implements IDisposable
@inject IFileExportService Export
@inject NotificationService Notify
@inject DialogService Dialogs
@inject AIStoryBuildersService Svc
@inject OrchestratorMethods Orchestrator
@inject IAppSettingsService Settings
@inject LogService Log
<PageTitle>Utility · AI StoryBuilders</PageTitle>
<ServiceEventToasts />

<h3 class="asb-sec">Utility</h3>
<p class="asb-sub">Fine-tuning, training data and the JsonL utility.</p>

<RadzenTabs RenderMode="TabRenderMode.Client" class="asb-util-tabs">
    <Tabs>
        <RadzenTabsItem Text="Fine Tuning">
            @if (!isOpenAI)
            {
                <p class="asb-note">@NotOpenAI</p>
            }
            else
            {
                <p>Use this page to manage your fine tuned models on <a href="https://platform.openai.com/finetune" target="_blank" rel="noopener noreferrer">platform.openai.com</a></p>
                @if (models is null)
                {
                    <div class="asb-cards asb-cards-1">
                        @for (var i = 0; i < 3; i++) { <div class="asb-scard"><div class="kgb-sk" style="width:40%;height:16px"></div></div> }
                    </div>
                }
                else if (models.Count == 0)
                {
                    <i>No fine tuned models found</i>
                }
                else
                {
                    <div class="asb-cards asb-cards-1">
                        @foreach (var m in models)
                        {
                            var verified = IsVerified(m.ModelId);
                            <div class="asb-scard">
                                <div class="asb-smeta"><b class="asb-model-name">@m.ModelName</b><span>@(verified ? "Fine-tuned · verified" : "Fine-tuned · not verified")</span></div>
                                @if (!verified)
                                {
                                    <RadzenButton Text="Verify" Icon="verified" ButtonStyle="ButtonStyle.Light" Disabled="@(verifying is not null)"
                                                  IsBusy="@(verifying == m.ModelId)" Click="@(() => VerifyAsync(m))" />
                                }
                                <RadzenButton Text="Edit" Icon="edit" ButtonStyle="ButtonStyle.Primary" Click="@(() => EditAsync(m))" />
                                <RadzenButton Text="Delete" Icon="delete" ButtonStyle="ButtonStyle.Danger" Click="@(() => DeleteAsync(m))" />
                            </div>
                        }
                    </div>
                }
            }
        </RadzenTabsItem>

        <RadzenTabsItem Text="Create Training Data">
            @if (!isOpenAI)
            {
                <p class="asb-note">@NotOpenAI</p>
            }
            else if (busy)
            {
                <div class="asb-mt"><RadzenProgressBar Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" /></div>
            }
            else
            {
                <div class="asb-field" style="max-width:420px">
                    <label for="td-story">Select a Story:</label>
                    <RadzenDropDown id="td-story" TValue="Story" Data="@stories" TextProperty="Title" Value="@story" ValueChanged="@((Story s) => OnStoryChangeAsync(s))" />
                </div>
                @if (rows is not null)
                {
                    <FineTuneView Rows="rows" />
                    <div class="asb-actions asb-mt">
                        <RadzenButton Text="Upload to OpenAI" Icon="publish" ButtonStyle="ButtonStyle.Success" Click="UploadAsync" />
                        <RadzenButton Text="Export Excel" Icon="get_app" ButtonStyle="ButtonStyle.Info" Click="ExportExcelAsync" />
                    </div>
                }
            }
        </RadzenTabsItem>

        <RadzenTabsItem Text="JsonL Utility">
            <p>Use this page to upload an Excel file and create a JsonL file to use for fine tuning</p>
            <div class="asb-actions">
                <RadzenButton Text="Download Template" Icon="download" ButtonStyle="ButtonStyle.Primary" Click="DownloadTemplateAsync" />
                <label class="rz-button rz-button-md rz-variant-filled rz-success rz-shade-default asb-file-button @(jsonlBusy ? "rz-state-disabled" : "")">
                    <span class="rz-button-box"><i class="notranslate rz-button-icon-left rzi">publish</i><span class="rz-button-text">Upload Excel file and create JsonL file</span></span>
                    <InputFile @key="jsonlKey" accept=".xls,.xlsx" OnChange="CreateJsonlAsync" disabled="@jsonlBusy" />
                </label>
            </div>
        </RadzenTabsItem>
    </Tabs>
</RadzenTabs>

@code {
    const string NotOpenAI = "Fine-tuning is available only when the AI provider is OpenAI.";
    const long MaxExcelBytes = 10 * 1024 * 1024;   // plan §9

    bool isOpenAI;
    List<AIStoryBuilderModel>? models;
    HashSet<string> verifiedModels = new(StringComparer.Ordinal);
    string? verifying;
    List<Story> stories = [];
    Story? story;
    List<TrainingData>? rows;
    bool busy;
    bool jsonlBusy;
    int jsonlKey;

    protected override async Task OnInitializedAsync()
    {
        Settings.Changed += OnSettingsChanged;
        await LoadAsync();
    }

    void OnSettingsChanged() => _ = InvokeAsync(async () => { await LoadAsync(); StateHasChanged(); });

    async Task LoadAsync()
    {
        var settings = await Settings.GetAsync();
        isOpenAI = settings.Provider == LlmProvider.OpenAI;
        verifiedModels = settings.VerifiedModels.Select(v => v.Model).ToHashSet(StringComparer.Ordinal);
        try { stories = await Svc.GetStorysAsync(); }
        catch (Exception ex) { Log.WriteToLog(ex.Message); stories = []; }
        if (isOpenAI) await LoadModelsAsync();
    }

    async Task LoadModelsAsync()
    {
        try
        {
            models = await Orchestrator.ListFineTunedModelsAsync();
        }
        catch (Exception ex)
        {
            models = [];
            ShowError(ex);
        }
    }

    bool IsVerified(string modelId) => verifiedModels.Contains(modelId);

    async Task VerifyAsync(AIStoryBuilderModel m)
    {
        verifying = m.ModelId;
        try
        {
            var result = await Settings.VerifyModelAsync(m.ModelId, CancellationToken.None);
            if (result.Passed)
            {
                Notify.Notify(NotificationSeverity.Success, "Model verified", $"{m.ModelName} passed the capability check.", 4000);
                verifiedModels.Add(m.ModelId);
            }
            else
            {
                Notify.Notify(NotificationSeverity.Error, "Model not verified", $"{m.ModelName} did not pass the {result.FailedAt} check: {result.Message}", 8000);
            }
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            verifying = null;
        }
    }

    async Task EditAsync(AIStoryBuilderModel m)
    {
        try
        {
            await Dialogs.OpenAsync<ModelEditDialog>("Edit Model Name", new Dictionary<string, object?> { [nameof(ModelEditDialog.Model)] = m },
                new DialogOptions { Width = "400px", CloseDialogOnEsc = true });
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        await LoadModelsAsync();
    }

    async Task DeleteAsync(AIStoryBuilderModel m)
    {
        var ok = await Dialogs.Confirm("Are you sure?", "Delete Model", new ConfirmOptions { OkButtonText = "Yes", CancelButtonText = "No" });
        if (ok != true) return;
        try
        {
            await Orchestrator.DeleteFineTuneModelAsync(m);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        await LoadModelsAsync();
    }

    async Task OnStoryChangeAsync(Story selected)
    {
        story = selected;
        busy = true;
        rows = null;
        StateHasChanged();
        try
        {
            rows = await Svc.CreateTrainingDataAsync(selected);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            busy = false;
        }
    }

    async Task UploadAsync()
    {
        if (rows is null) return;
        if (rows.Count < 10)
        {
            Notify.Notify(NotificationSeverity.Error, "Error", "You must have at least 10 lines of data to upload to OpenAI.", 4000);
            return;
        }
        busy = true;
        try
        {
            var fileId = await Orchestrator.UploadTrainingDataAsync(rows);
            Notify.Notify(NotificationSeverity.Success, "Fine Tuned Data Uploaded",
                $"The training data has been uploaded to OpenAI to be fine tuned (File ID: {fileId}).", 4000);
            await Orchestrator.StartFineTuneAsync(fileId);
            Notify.Notify(NotificationSeverity.Success, "Fine Tune Started", "The Fine Tuning of the training data has started.", 4000);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            busy = false;
        }
    }

    async Task ExportExcelAsync()
    {
        if (rows is null || story is null) return;
        try
        {
            using var stream = new MemoryStream(Svc.ExportTrainingData(rows));
            if (await Export.SaveAsync($"{story.Title}-TrainingData.xls", stream, "application/vnd.ms-excel"))
                Notify.Notify(NotificationSeverity.Success, "Saved", "Convert this file to JsonL to upload to OpenAI.", 4000);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    async Task DownloadTemplateAsync()
    {
        try
        {
            await using var template = typeof(AIStoryBuildersService).Assembly.GetManifestResourceStream("FineTunedTemplate.xls")
                ?? throw new InvalidOperationException("The template is missing from the app.");
            using var copy = new MemoryStream();
            await template.CopyToAsync(copy);
            copy.Position = 0;
            if (await Export.SaveAsync("FineTunedTemplate.xls", copy, "application/vnd.ms-excel"))
                Notify.Notify(NotificationSeverity.Success, "Saved", "The file was saved successfully.", 4000);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
    }

    async Task CreateJsonlAsync(InputFileChangeEventArgs e)
    {
        jsonlBusy = true;
        try
        {
            using var copy = new MemoryStream();
            await using (var upload = e.File.OpenReadStream(MaxExcelBytes))
                await upload.CopyToAsync(copy);
            var jsonl = TrainingDataJsonl.ToJsonl(TrainingDataJsonl.FromExcel(copy.ToArray()));
            using var output = new MemoryStream(Encoding.UTF8.GetBytes(jsonl));
            if (await Export.SaveAsync("FineTunedJson.jsonL", output, "application/jsonl"))
                Notify.Notify(NotificationSeverity.Success, "Saved", "The file was saved successfully.", 4000);
        }
        catch (Exception ex)
        {
            ShowError(ex);
        }
        finally
        {
            jsonlBusy = false;
            jsonlKey++;   // a fresh InputFile so the same file can be picked again
        }
    }

    void ShowError(Exception ex)
    {
        Notify.Notify(NotificationSeverity.Error, "Error", ex.Message, 4000);
        Log.WriteToLog(ex.Message);
    }

    public void Dispose() => Settings.Changed -= OnSettingsChanged;
}
