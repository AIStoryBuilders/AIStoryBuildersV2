    {
      "id": "paragraph:chapter 1:p1",
      "label": "P1",
      "type": "paragraph",
      "properties": {
        "text": "Balt and his father held the ridge until dusk.",
        "location": "Ridge",
        "timeline": "Years Before"
      }
    },
    {
      "id": "paragraph:chapter 1:p2",
      "label": "P2",
      "type": "paragraph",
      "properties": {
        "text": "When the smoke cleared, Father was gone.",
        "location": "Ridge",
        "timeline": "Years Before"
      }
    },
    {
      "id": "paragraph:chapter 1:p3",
      "label": "P3",
      "type": "paragraph",
      "properties": {
        "text": "Years later, Freya found Balt mending nets.",
        "location": "Village",
        "timeline": "Present Day"
      }
    },
    {
      "id": "chapter:chapter 2",
      "label": "Chapter 2",
      "type": "chapter",
      "properties": {
        "index": "2",
        "beatsSummary": "Balt and Freya set out to learn the truth."
      }
    },
    {
      "id": "paragraph:chapter 2:p1",
      "label": "P1",
      "type": "paragraph",
      "properties": {
        "text": "Freya handed Balt a raven feather.",
        "location": "Village",
        "timeline": "Present Day"
      }
    },
    {
      "id": "paragraph:chapter 2:p2",
      "label": "P2",
      "type": "paragraph",
      "properties": {
        "text": "At the ridge, Freya found a silver necklace in the heather.",
        "location": "Ridge",
        "timeline": "Present Day"
      }
    }
