<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0-rc.3.26522.148" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="11.0.0-rc.3.26522.148" PrivateAssets="all" />
    <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AIStoryBuildersV2.Shared\AIStoryBuildersV2.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- R11/R14: libraries that rely on reflection are kept whole when trimming (checked by the T18 published smoke test). -->
    <TrimmerRootAssembly Include="YamlDotNet" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI" />
    <TrimmerRootAssembly Include="Microsoft.Extensions.AI.Abstractions" />
    <TrimmerRootAssembly Include="Newtonsoft.Json" />
    <TrimmerRootAssembly Include="Xceed.Document.NET" />
    <TrimmerRootAssembly Include="Xceed.Words.NET" />
    <TrimmerRootAssembly Include="Xceed.Drawing.NET" />
    <TrimmerRootAssembly Include="EPPlus" />
    <TrimmerRootAssembly Include="ExcelDataReader" />
    <TrimmerRootAssembly Include="UglyToad.PdfPig" />
    <TrimmerRootAssembly Include="OpenAI" />
  </ItemGroup>

</Project>
